{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "trailingSlash": false,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/(og.png|apple-touch-icon.png|favicon.svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
